    "faq": {
      "enabled": true,
      "eyebrow": "Sıkça Sorulanlar",
      "title": "Merak edilenler",
      "items": [
        {
          "q": "Aynı gün teslimat yapıyor musunuz?",
          "a": "Evet. Hafta içi 17:00, hafta sonu 15:00'a kadar verilen siparişler aynı gün teslim edilir. Şehir içi ortalama teslim süremiz 2 saattir."
        },
        {
          "q": "Siparişi nasıl veriyorum?",
          "a": "Beğendiğiniz ürünleri sepete ekleyin, ardından 'Siparişi WhatsApp'tan Tamamla' butonuna basın. Ürün kodları, adetleri ve notunuz otomatik olarak mesaja eklenir."
        },
        {
          "q": "Çiçekler fotoğraftaki gibi mi geliyor?",
          "a": "Tasarımlar el yapımı olduğu için birebir aynı olmayabilir; ancak aynı renk paleti, aynı boyut ve aynı kalite standardı garanti edilir."
        },
        {
          "q": "Kart notu ekleyebilir miyim?",
          "a": "Elbette. Sepet ekranındaki 'Sipariş Notu' alanına yazdığınız mesaj, ücretsiz el yazısı kartla birlikte iletilir."
        },
        {
          "q": "Ödeme nasıl yapılıyor?",
          "a": "WhatsApp üzerinden siparişiniz onaylandıktan sonra havale/EFT, kredi kartı linki veya kapıda ödeme seçeneklerinden birini kullanabilirsiniz."
        },
        {
          "q": "Çiçek solarsa ne oluyor?",
          "a": "Teslimattan sonraki 48 saat içinde tazelik sorunu yaşarsanız, fotoğrafla bize ulaşın; ürününüzü ücretsiz yenileriz."
        }
      ]
    },
