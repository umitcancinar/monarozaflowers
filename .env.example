# Neon PostgreSQL — Mona Roza Flowers'a özel bağımsız şema kullanır (DB_SCHEMA),
# aynı veritabanındaki diğer projelerin tablolarıyla asla karışmaz.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DB_SCHEMA=monaroza

# Oturum imzalama anahtarı — production'da mutlaka rastgele/uzun bir değerle değiştirin.
JWT_SECRET=degistirin-uzun-rastgele-bir-deger

# İlk yönetici hesabı (sunucu ilk açılışta otomatik oluşturur)
ADMIN_EMAIL=admin@monarozaflowers.com
ADMIN_PASSWORD=monaroza2026

# ImgBB — admin panelinden yüklenen görseller burada barındırılır (ücretsiz key: api.imgbb.com)
# Boş bırakılırsa local modda görseller tarayıcıda base64 olarak kalır (küçük dosya sınırıyla).
IMGBB_API_KEY=

PORT=5173
